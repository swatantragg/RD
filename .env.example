# Copy to .env and change before any shared deployment.
WEB_PORT=8080
POSTGRES_PASSWORD=postgres-dev
MRM_OWNER_PASSWORD=mrm-owner-dev
MRM_APP_PASSWORD=mrm-app-dev
SECRET_KEY=change-me-in-production
# People can create their own accounts on the sign-in page (the first account becomes the administrator; later
# accounts are Viewers). Set to false to allow only accounts made by: docker compose run --rm api python -m mrm.cli create-user ...
ALLOW_SIGNUP=true
# true behind HTTPS
COOKIE_SECURE=auto
