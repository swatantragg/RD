# Docker Compose only (copy to .env next to docker-compose.yml if you need to change these).
# Every application setting and secret lives in backend/.env - see backend/.env.example.
# Address and port the web page is served on. 127.0.0.1 = this computer only; 0.0.0.0 = every network interface
# (only behind HTTPS and a firewall).
WEB_BIND=127.0.0.1
WEB_PORT=8080
