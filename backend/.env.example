# Royalty Reports - backend settings. Copy to backend/.env and fill in real values:
#     cp backend/.env.example backend/.env && chmod 600 backend/.env
# backend/.env holds secrets: it is ignored by git and by the Docker build, and must never be shared or committed.
# Docker Compose passes it to the database, bootstrap, api and worker containers. The application also reads it
# directly (a variable already set in the environment wins; ENV_FILE=<path> reads another file, ENV_FILE=none none).
#
# Strong random value:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ------------------------------------------------------------------ environment
# production: refuses to start with default or short database passwords and hides /api/docs
APP_ENV=production
# true shows the interactive API description at /api/docs (keep false in production)
API_DOCS=false

# ------------------------------------------------------------------ database logins
# Created when the database volume is first initialised (deploy/postgres/init.sh). Changing them later does NOT change
# an existing database by itself: run ALTER ROLE <name> PASSWORD '<new>' for postgres, mrm_owner and mrm_app first.
# postgres: superuser, used only inside the database container
POSTGRES_PASSWORD=replace-with-a-strong-random-value
# mrm_owner: owns the tables and runs migrations (bootstrap only)
MRM_OWNER_PASSWORD=replace-with-a-strong-random-value
# mrm_app: the running application; cannot change the schema, rewrite the audit log or delete evidence
MRM_APP_PASSWORD=replace-with-a-strong-random-value

# ------------------------------------------------------------------ database links
# Must use the same passwords as above. Host "db" is the database container inside Docker Compose.
DATABASE_URL=postgresql://mrm_app:replace-with-the-MRM_APP_PASSWORD@db:5432/mrm
MIGRATOR_DATABASE_URL=postgresql://mrm_owner:replace-with-the-MRM_OWNER_PASSWORD@db:5432/mrm
DB_POOL_SIZE=10

# ------------------------------------------------------------------ accounts and sessions
# true: while there is no Super Admin yet, the sign-in page offers "Set up (first account)", which becomes the Super
# Admin; after that self sign-up is closed and Admins add people. false: never (create the first account with
# python -m mrm.cli create-user EMAIL NAME SUPER_ADMIN PASSWORD).
ALLOW_SIGNUP=true
# A sign-in lasts this many hours
SESSION_HOURS=10
# Wrong passwords allowed per email in 15 minutes before sign-in is paused
LOGIN_MAX_FAILURES=8
# Session cookie only over HTTPS: true behind HTTPS, auto = follow the request, false = never (local HTTP only)
COOKIE_SECURE=auto

# ------------------------------------------------------------------ uploads (protection against oversized or crafted files)
MAX_UPLOAD_MB=64
MAX_UNZIPPED_MB=512
MAX_CELLS=2000000
MAX_SHEETS=100
MAX_ZIP_RATIO=200

# ------------------------------------------------------------------ logging
LOG_LEVEL=INFO
